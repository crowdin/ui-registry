{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "crowdin",
  "homepage": "https://crowdin.github.io/ui-registry",
  "include": ["./registry/registry.json"],
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Crowdin Theme",
      "description": "Canonical Crowdin design tokens as plain values. Apps embedded in the Crowdin iframe can additionally install @crowdin/app-theme to adopt the host --crowdin-* variables.",
      "cssVars": {
        "theme": {
          "radius-sm": "4px",
          "radius-md": "6px",
          "radius-lg": "8px",
          "radius-xl": "12px",
          "radius-2xl": "16px",
          "radius-3xl": "20px",
          "radius-4xl": "24px"
        },
        "light": {
          "radius": "0.5rem",
          "background": "oklch(1 0 0)",
          "foreground": "rgba(38, 50, 56, 0.87)",
          "card": "oklch(1 0 0)",
          "card-foreground": "rgba(38, 50, 56, 0.87)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "rgba(38, 50, 56, 0.87)",
          "primary": "oklch(0.268 0.022 230)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "rgba(38, 50, 56, 0.1)",
          "secondary-foreground": "rgba(38, 50, 56, 0.87)",
          "muted": "rgba(38, 50, 56, 0.05)",
          "muted-foreground": "rgba(38, 50, 56, 0.54)",
          "accent": "rgba(38, 50, 56, 0.05)",
          "accent-foreground": "rgba(38, 50, 56, 0.87)",
          "destructive": "#dc5242",
          "border": "oklch(0.91 0.006 228)",
          "input": "oklch(0.91 0.006 228)",
          "ring": "oklch(0.268 0.022 230)",
          "chart-1": "#3b82f6",
          "chart-2": "#22c55e",
          "chart-3": "#eab308",
          "chart-4": "#c99eff",
          "chart-5": "#dc5242",
          "sidebar": "#f5f7f8",
          "sidebar-foreground": "rgba(38, 50, 56, 0.87)",
          "sidebar-primary": "oklch(0.268 0.022 230)",
          "sidebar-primary-foreground": "oklch(1 0 0)",
          "sidebar-accent": "rgba(38, 50, 56, 0.05)",
          "sidebar-accent-foreground": "rgba(38, 50, 56, 0.87)",
          "sidebar-border": "oklch(0.91 0.006 228)",
          "sidebar-ring": "oklch(0.268 0.022 230)"
        },
        "dark": {
          "background": "#2c3139",
          "foreground": "oklch(1 0 0)",
          "card": "#373e48",
          "card-foreground": "oklch(1 0 0)",
          "popover": "#373e48",
          "popover-foreground": "oklch(1 0 0)",
          "primary": "oklch(0.636 0.165 142.5)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "rgba(255, 255, 255, 0.1)",
          "secondary-foreground": "oklch(1 0 0)",
          "muted": "rgba(255, 255, 255, 0.05)",
          "muted-foreground": "oklch(0.644 0.009 248)",
          "accent": "rgba(255, 255, 255, 0.05)",
          "accent-foreground": "oklch(1 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 10%)",
          "ring": "oklch(0.636 0.165 142.5)",
          "sidebar": "#16191d",
          "sidebar-foreground": "oklch(1 0 0)",
          "sidebar-primary": "oklch(0.636 0.165 142.5)",
          "sidebar-primary-foreground": "oklch(1 0 0)",
          "sidebar-accent": "rgba(255, 255, 255, 0.05)",
          "sidebar-accent-foreground": "oklch(1 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.636 0.165 142.5)"
        }
      }
    },
    {
      "name": "style",
      "type": "registry:style",
      "title": "Crowdin Style",
      "description": "Crowdin base style: installs the Crowdin theme tokens and Crowdin base CSS on top of the shadcn defaults.",
      "registryDependencies": ["@crowdin/theme"],
      "devDependencies": ["tw-animate-css", "shadcn"],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          }
        },
        "::-webkit-scrollbar": {
          "width": "6px",
          "height": "6px"
        },
        "::-webkit-scrollbar-track": {
          "background": "transparent"
        },
        "::-webkit-scrollbar-thumb": {
          "background": "color-mix(in oklch, var(--muted-foreground) 30%, transparent)",
          "border-radius": "3px"
        },
        "::-webkit-scrollbar-thumb:hover": {
          "background": "color-mix(in oklch, var(--muted-foreground) 50%, transparent)"
        },
        "button, [role=\"button\"], [role=\"combobox\"], [role=\"option\"]": {
          "cursor": "pointer"
        },
        "[data-sonner-toast] [data-description]": {
          "color": "var(--muted-foreground) !important",
          "opacity": "1 !important"
        },
        "[data-slot=\"tooltip-content\"]": {
          "border": "1px solid var(--border)",
          "background-color": "var(--popover)",
          "color": "var(--popover-foreground)",
          "box-shadow": "0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%)"
        },
        "[data-slot=\"tooltip-content\"] > span > svg": {
          "background-color": "var(--popover)",
          "fill": "var(--popover)",
          "border-right": "1px solid var(--border)",
          "border-bottom": "1px solid var(--border)"
        }
      }
    },
    {
      "name": "app-theme",
      "type": "registry:item",
      "title": "Crowdin App Theme",
      "description": "Opt-in bridge for apps embedded in the Crowdin iframe: re-points the Crowdin theme tokens at the host --crowdin-* variables, keeping the canonical values as fallbacks for local development.",
      "registryDependencies": ["@crowdin/theme"],
      "css": {
        ":root:root": {
          "--background": "var(--crowdin-level-2-bg, oklch(1 0 0))",
          "--foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--card": "var(--crowdin-level-3-bg, oklch(1 0 0))",
          "--card-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--popover": "var(--crowdin-level-3-bg, oklch(1 0 0))",
          "--popover-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--primary": "var(--crowdin-primary, oklch(0.268 0.022 230))",
          "--primary-foreground": "var(--crowdin-primary-btn-color, oklch(1 0 0))",
          "--secondary": "var(--crowdin-gray-01, rgba(38, 50, 56, 0.1))",
          "--secondary-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--muted": "var(--crowdin-gray-005, rgba(38, 50, 56, 0.05))",
          "--muted-foreground": "var(--crowdin-text-muted, rgba(38, 50, 56, 0.54))",
          "--accent": "var(--crowdin-gray-005, rgba(38, 50, 56, 0.05))",
          "--accent-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--destructive": "var(--crowdin-danger, #dc5242)",
          "--border": "var(--crowdin-border-color, oklch(0.91 0.006 228))",
          "--input": "var(--crowdin-border-color, oklch(0.91 0.006 228))",
          "--ring": "var(--crowdin-primary, oklch(0.268 0.022 230))",
          "--sidebar": "var(--crowdin-level-0-bg, #f5f7f8)",
          "--sidebar-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--sidebar-primary": "var(--crowdin-primary, oklch(0.268 0.022 230))",
          "--sidebar-primary-foreground": "var(--crowdin-primary-btn-color, oklch(1 0 0))",
          "--sidebar-accent": "var(--crowdin-gray-005, rgba(38, 50, 56, 0.05))",
          "--sidebar-accent-foreground": "var(--crowdin-body-color, rgba(38, 50, 56, 0.87))",
          "--sidebar-border": "var(--crowdin-border-color, oklch(0.91 0.006 228))",
          "--sidebar-ring": "var(--crowdin-primary, oklch(0.268 0.022 230))"
        },
        ":root:root.dark": {
          "--background": "var(--crowdin-level-2-bg, #2c3139)",
          "--foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--card": "var(--crowdin-level-3-bg, #373e48)",
          "--card-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--popover": "var(--crowdin-level-3-bg, #373e48)",
          "--popover-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--primary": "var(--crowdin-primary, oklch(0.636 0.165 142.5))",
          "--primary-foreground": "var(--crowdin-primary-btn-color, oklch(1 0 0))",
          "--secondary": "var(--crowdin-gray-01, rgba(255, 255, 255, 0.1))",
          "--secondary-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--muted": "var(--crowdin-gray-005, rgba(255, 255, 255, 0.05))",
          "--muted-foreground": "var(--crowdin-text-muted, oklch(0.644 0.009 248))",
          "--accent": "var(--crowdin-gray-005, rgba(255, 255, 255, 0.05))",
          "--accent-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--destructive": "var(--crowdin-danger, oklch(0.704 0.191 22.216))",
          "--border": "var(--crowdin-border-color, oklch(1 0 0 / 10%))",
          "--input": "var(--crowdin-border-color, oklch(1 0 0 / 10%))",
          "--ring": "var(--crowdin-primary, oklch(0.636 0.165 142.5))",
          "--sidebar": "var(--crowdin-level-0-bg, #16191d)",
          "--sidebar-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--sidebar-primary": "var(--crowdin-primary, oklch(0.636 0.165 142.5))",
          "--sidebar-primary-foreground": "var(--crowdin-primary-btn-color, oklch(1 0 0))",
          "--sidebar-accent": "var(--crowdin-gray-005, rgba(255, 255, 255, 0.05))",
          "--sidebar-accent-foreground": "var(--crowdin-body-color, oklch(1 0 0))",
          "--sidebar-border": "var(--crowdin-border-color, oklch(1 0 0 / 10%))",
          "--sidebar-ring": "var(--crowdin-primary, oklch(0.636 0.165 142.5))"
        }
      }
    }
  ]
}
