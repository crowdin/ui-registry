{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "crowdin",
  "homepage": "https://crowdin.github.io/ui-registry",
  "include": ["./registry/registry.json"],
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Crowdin Theme",
      "description": "Canonical Crowdin design tokens as plain values. Apps embedded in the Crowdin iframe can additionally install @crowdin/app-theme to adopt the host --crowdin-* variables.",
      "cssVars": {
        "theme": {
          "radius-sm": "4px",
          "radius-md": "6px",
          "radius-lg": "8px",
          "radius-xl": "12px",
          "radius-2xl": "16px",
          "radius-3xl": "20px",
          "radius-4xl": "24px"
        },
        "light": {
          "radius": "0.5rem",
          "background": "#ffffff",
          "foreground": "rgba(38, 38, 38, 0.87)",
          "card": "#ffffff",
          "card-foreground": "rgba(38, 38, 38, 0.87)",
          "popover": "#ffffff",
          "popover-foreground": "rgba(38, 38, 38, 0.87)",
          "primary": "#262626",
          "primary-foreground": "#ffffff",
          "secondary": "rgba(38, 38, 38, 0.1)",
          "secondary-foreground": "rgba(38, 38, 38, 0.87)",
          "muted": "rgba(38, 38, 38, 0.05)",
          "muted-foreground": "rgba(38, 38, 38, 0.67)",
          "accent": "rgba(38, 38, 38, 0.05)",
          "accent-foreground": "rgba(38, 38, 38, 0.87)",
          "destructive": "#dc5242",
          "border": "rgba(38, 38, 38, 0.1)",
          "input": "rgba(38, 38, 38, 0.1)",
          "ring": "#262626",
          "chart-1": "#3b82f6",
          "chart-2": "#22c55e",
          "chart-3": "#eab308",
          "chart-4": "#c99eff",
          "chart-5": "#dc5242",
          "sidebar": "#eeeeee",
          "sidebar-foreground": "rgba(38, 38, 38, 0.87)",
          "sidebar-primary": "#262626",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "rgba(38, 38, 38, 0.05)",
          "sidebar-accent-foreground": "rgba(38, 38, 38, 0.87)",
          "sidebar-border": "rgba(38, 38, 38, 0.1)",
          "sidebar-ring": "#262626"
        },
        "dark": {
          "background": "#1c1c1c",
          "foreground": "rgba(244, 244, 244, 0.87)",
          "card": "#262626",
          "card-foreground": "rgba(244, 244, 244, 0.87)",
          "popover": "#1c1c1c",
          "popover-foreground": "rgba(244, 244, 244, 0.87)",
          "primary": "#f4f4f4",
          "primary-foreground": "#262626",
          "secondary": "rgba(244, 244, 244, 0.1)",
          "secondary-foreground": "rgba(244, 244, 244, 0.87)",
          "muted": "rgba(244, 244, 244, 0.05)",
          "muted-foreground": "rgba(244, 244, 244, 0.54)",
          "accent": "rgba(244, 244, 244, 0.05)",
          "accent-foreground": "rgba(244, 244, 244, 0.87)",
          "destructive": "#fd413c",
          "border": "rgba(244, 244, 244, 0.1)",
          "input": "rgba(244, 244, 244, 0.1)",
          "ring": "#f4f4f4",
          "sidebar": "#141414",
          "sidebar-foreground": "rgba(244, 244, 244, 0.87)",
          "sidebar-primary": "#f4f4f4",
          "sidebar-primary-foreground": "#262626",
          "sidebar-accent": "rgba(244, 244, 244, 0.05)",
          "sidebar-accent-foreground": "rgba(244, 244, 244, 0.87)",
          "sidebar-border": "rgba(244, 244, 244, 0.1)",
          "sidebar-ring": "#f4f4f4"
        }
      }
    },
    {
      "name": "style",
      "type": "registry:style",
      "title": "Crowdin Style",
      "description": "Crowdin base style: installs the Crowdin theme tokens and Crowdin base CSS on top of the shadcn defaults.",
      "registryDependencies": ["@crowdin/theme"],
      "devDependencies": ["tw-animate-css", "shadcn"],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          }
        },
        ":root": {
          "scrollbar-width": "thin",
          "scrollbar-color": "color-mix(in oklch, var(--muted-foreground) 30%, transparent) transparent"
        },
        "button, [role=\"button\"], [role=\"combobox\"], [role=\"option\"]": {
          "cursor": "pointer"
        },
        "[data-sonner-toast] [data-description]": {
          "color": "var(--muted-foreground) !important",
          "opacity": "1 !important"
        },
        "[data-slot=\"tooltip-content\"]": {
          "border": "1px solid var(--border)",
          "background-color": "var(--popover)",
          "color": "var(--popover-foreground)",
          "box-shadow": "0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%)"
        },
        "[data-slot=\"tooltip-content\"] > span > svg": {
          "background-color": "var(--popover)",
          "fill": "var(--popover)",
          "border-right": "1px solid var(--border)",
          "border-bottom": "1px solid var(--border)"
        }
      }
    },
    {
      "name": "app-theme",
      "type": "registry:item",
      "title": "Crowdin App Theme",
      "description": "Host theming for apps embedded in the Crowdin iframe: re-points the Crowdin theme tokens at the host --crowdin-* variables (canonical values remain as fallbacks for local development) and ships the host bridge - lib/crowdin-host.ts pulls the host palette via AP.getCssVariables and re-applies it on host theme changes; hooks/use-crowdin-theme.ts wraps it for React.",
      "registryDependencies": ["@crowdin/theme"],
      "files": [
        {
          "path": "registry/crowdin/crowdin-host.ts",
          "type": "registry:lib"
        },
        {
          "path": "registry/crowdin/use-crowdin-theme.ts",
          "type": "registry:hook"
        }
      ],
      "css": {
        ":root:root": {
          "--background": "var(--crowdin-level-2-bg, #ffffff)",
          "--foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--card": "var(--crowdin-level-3-bg, #ffffff)",
          "--card-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--popover": "var(--crowdin-level-2-bg, #ffffff)",
          "--popover-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--primary": "var(--crowdin-primary, #262626)",
          "--primary-foreground": "var(--crowdin-primary-foreground, #ffffff)",
          "--secondary": "var(--crowdin-gray-01, rgba(38, 38, 38, 0.1))",
          "--secondary-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--muted": "var(--crowdin-gray-005, rgba(38, 38, 38, 0.05))",
          "--muted-foreground": "var(--crowdin-text-muted, rgba(38, 38, 38, 0.67))",
          "--accent": "var(--crowdin-gray-005, rgba(38, 38, 38, 0.05))",
          "--accent-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--destructive": "var(--crowdin-danger, #dc5242)",
          "--border": "var(--crowdin-border-color, rgba(38, 38, 38, 0.1))",
          "--input": "var(--crowdin-border-color, rgba(38, 38, 38, 0.1))",
          "--ring": "var(--crowdin-primary, #262626)",
          "--sidebar": "var(--crowdin-level-0-bg, #eeeeee)",
          "--sidebar-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--sidebar-primary": "var(--crowdin-primary, #262626)",
          "--sidebar-primary-foreground": "var(--crowdin-primary-foreground, #ffffff)",
          "--sidebar-accent": "var(--crowdin-gray-005, rgba(38, 38, 38, 0.05))",
          "--sidebar-accent-foreground": "var(--crowdin-body-color, rgba(38, 38, 38, 0.87))",
          "--sidebar-border": "var(--crowdin-border-color, rgba(38, 38, 38, 0.1))",
          "--sidebar-ring": "var(--crowdin-primary, #262626)"
        },
        ":root:root.dark": {
          "--background": "var(--crowdin-level-2-bg, #1c1c1c)",
          "--foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--card": "var(--crowdin-level-3-bg, #262626)",
          "--card-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--popover": "var(--crowdin-level-2-bg, #1c1c1c)",
          "--popover-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--primary": "var(--crowdin-primary, #f4f4f4)",
          "--primary-foreground": "var(--crowdin-primary-foreground, #262626)",
          "--secondary": "var(--crowdin-gray-01, rgba(244, 244, 244, 0.1))",
          "--secondary-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--muted": "var(--crowdin-gray-005, rgba(244, 244, 244, 0.05))",
          "--muted-foreground": "var(--crowdin-text-muted, rgba(244, 244, 244, 0.54))",
          "--accent": "var(--crowdin-gray-005, rgba(244, 244, 244, 0.05))",
          "--accent-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--destructive": "var(--crowdin-danger, #fd413c)",
          "--border": "var(--crowdin-border-color, rgba(244, 244, 244, 0.1))",
          "--input": "var(--crowdin-border-color, rgba(244, 244, 244, 0.1))",
          "--ring": "var(--crowdin-primary, #f4f4f4)",
          "--sidebar": "var(--crowdin-level-0-bg, #141414)",
          "--sidebar-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--sidebar-primary": "var(--crowdin-primary, #f4f4f4)",
          "--sidebar-primary-foreground": "var(--crowdin-primary-foreground, #262626)",
          "--sidebar-accent": "var(--crowdin-gray-005, rgba(244, 244, 244, 0.05))",
          "--sidebar-accent-foreground": "var(--crowdin-body-color, rgba(244, 244, 244, 0.87))",
          "--sidebar-border": "var(--crowdin-border-color, rgba(244, 244, 244, 0.1))",
          "--sidebar-ring": "var(--crowdin-primary, #f4f4f4)"
        }
      }
    }
  ]
}
